# Copy this file to .env for local development and replace placeholders locally.
# Never commit .env or real API keys, email addresses, or phone numbers.

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender@example.com
RESEND_TEST_RECIPIENT=your_test_inbox@example.com

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+your_twilio_sandbox_number
TWILIO_TEST_RECIPIENT=whatsapp:+your_test_number
TWILIO_CUSTOMER_TEST_RECIPIENTS=whatsapp:+your_first_test_number,whatsapp:+your_second_test_number
TWILIO_WEBHOOK_BASE_URL=https://your-public-backend-url
